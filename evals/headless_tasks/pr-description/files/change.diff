+++ b/tests/test_retry.py
@@ -0,0 +1,8 @@
+from ledger.retry import backoff_seconds
+
+
+def test_backoff_doubles_until_the_cap():
+    assert backoff_seconds(0) == 0.5
+    assert backoff_seconds(1) == 1.0
+    assert backoff_seconds(3) == 4.0
+    assert backoff_seconds(10) == 8.0
