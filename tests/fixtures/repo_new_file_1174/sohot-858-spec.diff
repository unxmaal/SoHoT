+def _requeue_length_refusals(conn) -> None:
+    """A #803 length refusal declined a screened candidate #813 now pauses instead; back to screened. #815."""
+    rows = conn.execute(
+        "SELECT p.id, p.name FROM proposals p JOIN verdicts v ON v.id = p.state_verdict_id "
+        "WHERE p.state = 'declined' AND v.outcome = 'declined' AND v.tier = 'adopt' "
+        "AND v.reason = 'limit' AND COALESCE(v.until, '') = '' "
+        "AND v.detail LIKE '%not run:%projected at%over the%budget%' "
+        "AND v.detail NOT LIKE '%underpowered%' "
+        "AND COALESCE(v.failure_class, '') <> 'underpowered' "
+        "AND NOT EXISTS (SELECT 1 FROM verdicts l WHERE l.proposal_id = p.id "
+        " AND l.id > v.id) "
+        "AND (SELECT w.outcome FROM verdicts w WHERE w.proposal_id = p.id "
+        " AND w.id < v.id ORDER BY w.id DESC LIMIT 1) = 'screened'").fetchall()
+    for row in rows:
+        _migration_retraction(conn, row["id"], row["name"], "screened", SCREEN,
+                              f"retracted: the #803 length cap refused {row['name']} "
+                              f"before it was measured; #813 pauses and resumes a long "
+                              f"run instead, so it is measurable again")
+
