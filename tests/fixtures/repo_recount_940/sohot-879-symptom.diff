+#: The header line Python prints for a warning: "path:line: SomeWarning: message".
+_WARNING_LINE = re.compile(r"^.*:\d+: \w*Warning: ")
+
+
+def stderr_evidence(stderr: str, limit: int = 300) -> str:
+    """The stderr tail kept as evidence, without Python warnings and their source lines.
+
+    A warning is chatter about the harness, not about the candidate, and stored
+    in a verdict detail it reads as if the run said it.
+    """
+    kept = []
+    after_warning = False
+    for line in (stderr or "").splitlines():
+        if _WARNING_LINE.match(line):
+            after_warning = True
+            continue
+        if after_warning and line.startswith((" ", "\t")):
+            # The source line warnings.warn prints beneath its header.
+            after_warning = False
+            continue
+        after_warning = False
+        kept.append(line)
+    return " ".join(" ".join(kept).split())[-limit:]
+
