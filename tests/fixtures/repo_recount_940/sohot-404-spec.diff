 )
 
+#: Phrases that mean the model server itself is dead, not merely that one
+#: request was refused. Once one is seen, every later request to that server
+#: fails the same way, so a screen that keeps going spends every remaining
+#: candidate on a dead server.
+SERVER_DIED = (
+    "generation thread died",
+    "command buffer execution failed",
+)
+
+
+def server_died(detail: str) -> str:
+    """The phrase saying the model server is dead, or "".
+
+    A dead server is a fact about the harness's own infrastructure. The
+    caller must stop and report it rather than carry on and record each
+    remaining candidate against it.
+    """
+    text = (detail or "").lower()
+    for phrase in SERVER_DIED:
+        if phrase in text:
+            return phrase
+    return ""
+
 
