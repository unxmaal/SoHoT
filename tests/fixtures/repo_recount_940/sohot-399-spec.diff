+def past_inspect(conn, name: str) -> str:
+    """Why the inspect tier must not re-queue `name`, or "" when it may.
+
+    The latest verdict decides: terminal, screened, or written by a tier that
+    comes after inspect.
+    """
+    row = conn.execute(
+        "SELECT v.outcome, v.tier FROM verdicts v JOIN proposals p "
+        "ON p.id = v.proposal_id WHERE p.name = ? "
+        "ORDER BY v.id DESC LIMIT 1", (name,)).fetchone()
+    if not row:
+        return ""
+    outcome, tier = row["outcome"], row["tier"] or ""
+    if outcome in TERMINAL or outcome == "screened" or tier in PAST_INSPECT:
+        return f"latest verdict is {outcome} at {tier or 'an unnamed tier'}"
+    return ""
