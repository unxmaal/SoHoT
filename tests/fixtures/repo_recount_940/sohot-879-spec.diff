+#: A Python warning header, "path:123: SomeWarning: message".
+_WARNING_LINE = re.compile(r"^\S.*:\d+: \w*Warning: ")
+
+
+def stderr_evidence(stderr: str, summary) -> str:
+    """The stderr tail kept beside a verdict for a person; "" when the run wrote a receipt.
+
+    A run that produced a summary already says what happened, so its stderr
+    adds nothing but chatter, and warnings reached the store that way. Where
+    there is no receipt, Python warnings and the source line printed beneath
+    them are dropped before the tail is taken.
+    """
+    if summary is not None or not stderr:
+        return ""
+    kept, skip_source = [], False
+    for line in stderr.splitlines():
+        if _WARNING_LINE.match(line):
+            skip_source = True
+            continue
+        if skip_source and line[:1].isspace():
+            skip_source = False
+            continue
+        skip_source = False
+        kept.append(line)
+    return " ".join(" ".join(kept).split())[-300:]
+
